<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Peterson Hub</title>
  <link rel="stylesheet" href="styles.css">
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background-color: #f0f4fa;
      color: #333;
    }

    header {
      background-color: #7287DB;
      color: white;
      padding: 1em;
      text-align: center;
    }

    header img {
      max-height: 60px;
    }

    nav {
      background-color: #7E72DB;
      padding: 1em;
    }

    nav ul {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      padding: 0;
      margin: 0;
    }

    nav li {
      margin-right: 15px;
    }

    nav a {
      text-decoration: none;
      color: white;
      font-weight: bold;
    }

    main {
      padding: 2em;
    }

    section {
      margin-bottom: 2em;
      background: white;
      padding: 1em;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    #quick-message {
      padding: 0.5em;
      width: 70%;
    }

    button {
      padding: 0.5em 1em;
      background-color: #7287DB;
      border: none;
      color: white;
      cursor: pointer;
      border-radius: 5px;
    }

    footer {
      text-align: center;
      padding: 1em;
      background-color: #7287DB;
      color: white;
    }
  </style>
</head>

<body>
  <header>
    <div class="logo">
      <img src="/path-to-your-logo.png" alt="The Peterson Hub Logo">
    </div>
    <h1>The Peterson Hub</h1>
    <p class="verse">"As for me and my house, we will serve the Lord." – Joshua 24:15</p>
  </header>

  <nav>
    <ul>
      <li><a href="#">Home</a></li>
      <li><a href="#calendar">Calendar</a></li>
      <li><a href="#chores">Chores</a></li>
      <li><a href="#cars">Car Pool</a></li>
      <li><a href="#shopping">Shopping List</a></li>
      <li><a href="#wishlist">Wish List</a></li>
      <li><a href="#chat">Group Chats</a></li>
      <li><a href="#blog">Blog</a></li>
      <li><a href="#memes">Memes</a></li>
      <li><a href="#bible">Bible Challenge</a></li>
      <li><a href="#prayer">Prayer Wall</a></li>
      <li><a href="#polls">Polls</a></li>
      <li><a href="#awards">Awards</a></li>
      <li><a href="#pets">Pet Corner</a></li>
    </ul>
  </nav>

  <main>
    <section id="dashboard">
      <h2>Today's Overview</h2>
      <div id="events">Loading today's events...</div>
      <div id="chores">Loading your chores...</div>
      <div id="car-status">
        <h3>Car Reservations</h3>
        <ul>
          <li>Dodge (Dad) – Reserved</li>
          <li>Toyota (Mom) – Reserved</li>
          <li>Chrysler – Available <button>Claim</button></li>
          <li>Buick (Lydia) – Ask Lydia</li>
          <li>Subaru (Grandma) – Ask Grandma</li>
        </ul>
      </div>
      <div id="quick-chat">
        <label for="quick-message">Quick Chat:</label>
        <input type="text" id="quick-message" placeholder="Type a message...">
        <button>Send</button>
      </div>
    </section>

    <section id="bible">
      <h2>Verse of the Day</h2>
      <p id="daily-verse">"Let all that you do be done in love." – 1 Corinthians 16:14</p>
      <h3>Challenges</h3>
      <ul>
        <li>Daily</li>
        <li>Weekly</li>
        <li>Monthly</li>
        <li>Yearly</li>
      </ul>
    </section>

    <section id="shopping">
      <h2>Shopping List</h2>
      <ul>
        <li>Groceries</li>
        <li>Toiletries</li>
        <li>Clothes</li>
      </ul>
    </section>

    <section id="wishlist">
      <h2>Wish List</h2>
      <p>Add links to birthday or Christmas wish items here.</p>
    </section>

    <section id="blog">
      <h2>Family Blog</h2>
      <p>Share your stories and updates here!</p>
    </section>

    <section id="memes">
      <h2>Memes</h2>
      <p>Upload and enjoy family-made memes!</p>
    </section>
  </main>

  <footer>
    <p>&copy; 2025 The Peterson Hub</p>
  </footer>

  <script src="scripts.js"></script>
</body>

</html>
